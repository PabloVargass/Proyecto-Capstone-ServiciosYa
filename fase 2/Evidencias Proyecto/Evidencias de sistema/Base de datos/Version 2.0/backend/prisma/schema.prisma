generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProveedorAutenticacion {
  LOCAL
  GOOGLE
}

model Usuario {
  identidad SolicitudIdentidad? @relation("IdentidadUsuario")
  identidadesRevisadas SolicitudIdentidad[] @relation("RevisionIdentidad")
  rol RolAdministrativo @default(USUARIO)
  activo Boolean @default(true)
  versionSesion Int @default(0)
  invitaciones InvitacionCuenta[]
  auditorias AuditoriaAdministrativa[]
  id         String                 @id @default(uuid())
  nombre     String
  rut        String                 @unique
  correo     String                 @unique
  telefono   String?
  contrasena String?
  proveedor  ProveedorAutenticacion @default(LOCAL)
  googleId   String?                @unique

  correoVerificadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  trabajos      Trabajo[]
  ofertasServicio OfertaServicio[]
  postulaciones Postulacion[]

  conversacionesComoPropietario Conversacion[] @relation("PropietarioConversacion")
  conversacionesComoTrabajador  Conversacion[] @relation("TrabajadorConversacion")

  mensajes Mensaje[]

  resenasRealizadas Resena[] @relation("AutorResena")
  resenasRecibidas  Resena[] @relation("ReceptorResena")

  tokensRecuperacion       TokenRecuperacion[]
  tokensVerificacionCorreo TokenVerificacionCorreo[]
}

enum EstadoIdentidad {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model SolicitudIdentidad {
  id String @id @default(uuid())
  usuarioId String @unique
  usuario Usuario @relation("IdentidadUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  estado EstadoIdentidad @default(PENDIENTE)
  foto Bytes
  fotoTipo String
  certificado Bytes
  certificadoTipo String
  consentimientoEn DateTime @default(now())
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  revisadoEn DateTime?
  revisadoPorId String?
  revisadoPor Usuario? @relation("RevisionIdentidad", fields: [revisadoPorId], references: [id], onDelete: Restrict)
  motivoRevision String?
  @@index([estado, creadoEn])
}

enum EstadoTrabajo {
  PUBLICADO
  ASIGNADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

enum TipoPublicacion {
  OPORTUNIDAD
  SERVICIO
}

model Trabajo {
  tipo TipoPublicacion @default(OPORTUNIDAD)
  venceEn DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + interval '24 hours')"))
  servicioOrigenId String?
  servicioOrigen Trabajo? @relation("ContratacionServicio", fields: [servicioOrigenId], references: [id], onDelete: Restrict)
  contrataciones Trabajo[] @relation("ContratacionServicio")
  ofertasServicio OfertaServicio[] @relation("PublicacionOfertas")
  ofertaContratada OfertaServicio? @relation("TrabajoOferta")
  oculto Boolean @default(false)
  categoriaId String?
  categoriaCatalogo Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  id           String        @id @default(uuid())
  titulo       String
  descripcion  String
  categoria    String
  comuna       String
  presupuesto  Int
  fechaTrabajo DateTime?
  estado       EstadoTrabajo @default(PUBLICADO)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  propietarioId String
  propietario   Usuario @relation(fields: [propietarioId], references: [id], onDelete: Cascade)

  postulaciones Postulacion[]
  conversacion  Conversacion?

  resenas Resena[]
}

model OfertaServicio {
  id String @id @default(uuid())
  servicioId String
  servicio Trabajo @relation("PublicacionOfertas", fields: [servicioId], references: [id], onDelete: Restrict)
  solicitanteId String
  solicitante Usuario @relation(fields: [solicitanteId], references: [id], onDelete: Restrict)
  importe Int
  estado EstadoPostulacion @default(PENDIENTE)
  trabajoId String @unique
  trabajo Trabajo @relation("TrabajoOferta", fields: [trabajoId], references: [id], onDelete: Restrict)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  @@unique([servicioId, solicitanteId])
}

enum EstadoPostulacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

model Postulacion {
  id     String            @id @default(uuid())
  estado EstadoPostulacion @default(PENDIENTE)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String
  trabajoId String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  trabajo Trabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  conversacion Conversacion?

  @@unique([usuarioId, trabajoId])
}

model Conversacion {
  id String @id @default(uuid())

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  trabajoId     String @unique
  postulacionId String @unique

  propietarioId String
  trabajadorId  String

  trabajo     Trabajo     @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  postulacion Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)

  propietario Usuario @relation("PropietarioConversacion", fields: [propietarioId], references: [id], onDelete: Cascade)
  trabajador  Usuario @relation("TrabajadorConversacion", fields: [trabajadorId], references: [id], onDelete: Cascade)

  mensajes Mensaje[]
}

model Mensaje {
  id String @id @default(uuid())

  contenido String
  leido     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  conversacionId String
  remitenteId    String

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  remitente    Usuario      @relation(fields: [remitenteId], references: [id], onDelete: Cascade)
}

model Resena {
  oculta Boolean @default(false)
  id String @id @default(uuid())

  puntuacion Int
  comentario String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  trabajoId  String
  autorId    String
  receptorId String

  trabajo  Trabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  autor    Usuario @relation("AutorResena", fields: [autorId], references: [id], onDelete: Cascade)
  receptor Usuario @relation("ReceptorResena", fields: [receptorId], references: [id], onDelete: Cascade)

  @@unique([trabajoId, autorId, receptorId])
}

enum RolAdministrativo {
  USUARIO
  ADMIN
}

model Categoria {
  id String @id @default(uuid())
  nombre String @unique
  activo Boolean @default(true)
  creadoEn DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  trabajos Trabajo[]
  nombres CategoriaNombre[]
}

model CategoriaNombre {
  nombre String @id
  categoriaId String
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
}

model AuditoriaAdministrativa {
  id String @id @default(uuid())
  actorId String
  actor Usuario @relation(fields: [actorId], references: [id], onDelete: Restrict)
  accion String
  recurso String
  recursoId String
  motivo String
  cambios Json
  creadoEn DateTime @default(now())
  @@index([creadoEn])
}

model InvitacionCuenta {
  id String @id @default(uuid())
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  expiraEn DateTime
  usadoEn DateTime?
  creadoEn DateTime @default(now())
  @@index([usuarioId])
}

model TokenRecuperacion {
  id String @id @default(uuid())

  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?

  creadoEn DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model TokenVerificacionCorreo {
  id String @id @default(uuid())

  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?

  creadoEn DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}
